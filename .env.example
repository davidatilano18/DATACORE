# Conexión a PostgreSQL. Copia este archivo a .env y llena los valores.
PG_HOST=localhost
PG_PORT=5432
PG_DB=datacore
# Superusuario que definiste al instalar PostgreSQL (solo se usa para crear la BD y los roles).
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=
# Rol de la aplicación (ETL, modelo, API) y rol de solo lectura (dashboard).
PG_APP_USER=datacore_app
PG_APP_PASSWORD=
PG_LECTOR_USER=datacore_lector
PG_LECTOR_PASSWORD=